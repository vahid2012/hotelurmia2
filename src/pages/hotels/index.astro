---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HOTELS } from '../../data/site';

const title = 'لیست هتل‌های ارومیه | آکای تراول';
const description = 'فهرست کامل هتل‌های ارومیه برای رزرو؛ از هتل ۵ ستاره تا هتل‌های اقتصادی.';
---
<BaseLayout title={title} description={description} path="/hotels">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-brand-800 mb-4">هتل‌های ارومیه</h1>
    <p class="text-gray-600 mb-8 max-w-3xl">فهرست هتل‌های ارومیه برای رزرو. برای اطلاع از جزئیات و قیمت دقیق هر هتل، با دفتر آکای تراول تماس بگیرید.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {HOTELS.map((h) => (
        <a href={`/hotels/${h.slug}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-sand-200">
          <!-- TODO: real photo -->
          <img src={h.image} alt={h.nameFa} width="400" height="250" class="w-full h-48 object-cover" loading="lazy" />
          <div class="p-5">
            <h2 class="font-bold text-lg text-gray-900 mb-1">{h.nameFa}</h2>
            {h.star && <p class="text-sm text-amber-600 mb-2">{'★'.repeat(h.star)}</p>}
            <p class="text-sm text-gray-600 line-clamp-3">{h.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-8 text-sm text-gray-500">
      <p>برای رزرو هتل ارومیه به <a href="/" class="text-brand-600 hover:underline">صفحه اصلی</a> یا <a href="/contact" class="text-brand-600 hover:underline">صفحه تماس</a> مراجعه کنید.</p>
    </div>
  </section>
</BaseLayout>
