---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReservationButtons from '../../components/ReservationButtons.astro';

const title = 'تور فرهنگی تاریخی ارومیه | آکای تراول';
const description = 'تور فرهنگی تاریخی ارومیه با راهنمای محلی؛ آشنایی با جاذبه‌های تاریخی شهر.';

const tourSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: 'تور فرهنگی تاریخی ارومیه',
  description,
  url: 'https://hotelurmia.ir/tours/urmia-cultural-historical-tour',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'جاذبه‌های تور فرهنگی ارومیه چیست؟', acceptedAnswer: { '@type': 'Answer', text: 'برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید.' } },
  ],
};
---
<BaseLayout title={title} description={description} path="/tours/urmia-cultural-historical-tour" schema={[tourSchema, faqSchema]}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <!-- TODO: real photo -->
    <img src="/images/urmia-cultural-tour.webp" alt="تور فرهنگی تاریخی ارومیه" width="1200" height="630" class="w-full h-64 md:h-80 object-cover rounded-2xl mb-6" fetchpriority="high" />
    <h1 class="text-2xl md:text-3xl font-bold text-brand-800 mb-4">تور فرهنگی تاریخی ارومیه</h1>
    <p class="text-gray-700 leading-8 mb-6">تور فرهنگی تاریخی ارومیه با راهنمای محلی برای آشنایی با جاذبه‌های تاریخی شهر. برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید.</p>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-3">جاذبه‌های تور</h2>
      <p class="text-gray-700 leading-8 mb-4">برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید. فهرست کامل جاذبه‌ها از طریق تماس مستقیم ارائه می‌شود.</p>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-4">رزرو تور</h2>
      <ReservationButtons pageName="تور فرهنگی تاریخی ارومیه" />
    </section>

    <section class="bg-sand-50 rounded-xl p-5 mb-8">
      <h2 class="text-lg font-bold text-brand-700 mb-3">سؤالات پرتکرار</h2>
      <div class="space-y-4">
        <div><h3 class="font-semibold text-gray-900 mb-1">جاذبه‌های تور فرهنگی ارومیه چیست؟</h3><p class="text-sm text-gray-600 leading-7">برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید.</p></div>
      </div>
    </section>

    <nav class="text-sm text-gray-500">
      <a href="/" class="text-brand-600 hover:underline">خانه</a> | <a href="/tours/urmia-van-combined-tour" class="text-brand-600 hover:underline">تور ارومیه به وان</a> | <a href="/hotels" class="text-brand-600 hover:underline">هتل‌ها</a>
    </nav>
  </article>
</BaseLayout>
