---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../data/site';
import { BLOG_CONTENT } from '../../data/blog-content';

export async function getStaticPaths() {
  return BLOG_POSTS.map((b) => ({ params: { slug: b.slug }, props: { post: b } }));
}

const { post } = Astro.props;
const content = BLOG_CONTENT[post.slug];
const related = BLOG_POSTS.filter((b) => b.slug !== post.slug).slice(0, 3);

const title = `${post.title} | آکای تراول`;
const description = post.description;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  image: post.image,
  url: `https://hotelurmia.ir/blog/${post.slug}`,
  articleSection: post.category,
};
---
<BaseLayout title={title} description={description} path={`/blog/${post.slug}`} image={post.image} schema={articleSchema}>
  <article class="max-w-3xl mx-auto px-4 py-10">
    <!-- TODO: replace with real photo -->
    <img src={post.image} alt={post.title} width="800" height="500" class="w-full h-64 object-cover rounded-2xl mb-6" fetchpriority="high" />
    <span class="text-sm text-brand-600">{post.category}</span>
    <h1 class="text-2xl md:text-3xl font-bold text-brand-800 mt-2 mb-4">{post.h1}</h1>

    <p class="text-gray-700 leading-8 mb-6">{content.intro}</p>

    <div class="space-y-8 mb-6">
      {content.sections.map((s) => (
        <section>
          <h2 class="text-xl font-bold text-brand-700 mb-3">{s.heading}</h2>
          <p class="text-gray-700 leading-8 mb-4" set:html={s.body}></p>
          {s.image && (
            <>
              <!-- TODO: replace with real photo -->
              <img src={s.image} alt={s.imageAlt} width="800" height="500" class="w-full h-56 object-cover rounded-xl my-4" loading="lazy" />
            </>
          )}
        </section>
      ))}
    </div>

    <section class="bg-sand-50 rounded-xl p-5 mb-6">
      <h2 class="text-lg font-bold text-brand-700 mb-2">نتیجه‌گیری</h2>
      <p class="text-gray-700 leading-8">{content.conclusion}</p>
    </section>

    {post.externalLinks && post.externalLinks.length > 0 && (
      <section class="bg-white rounded-xl p-4 mb-6 text-sm border border-sand-200">
        <h2 class="font-bold mb-2">پیوندهای مرتبط</h2>
        {post.externalLinks.map((l) => (
          <p class="mb-1"><a href={l.url} target="_blank" rel="noopener" class="text-brand-600 hover:underline">{l.anchor}</a></p>
        ))}
      </section>
    )}

    <section class="mb-6">
      <h2 class="text-sm font-bold text-gray-500 mb-3">صفحات مرتبط</h2>
      <div class="flex flex-wrap gap-2">
        {content.internalLinks.map((l) => (
          <a href={l.url} class="text-xs bg-white border border-sand-200 rounded-lg px-3 py-1.5 text-brand-600 hover:border-brand-300 transition-colors">{l.anchor}</a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-bold text-brand-700 mb-4">مقالات مرتبط</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map((b) => (
          <a href={`/blog/${b.slug}`} class="bg-white rounded-xl p-4 border border-sand-200 hover:border-brand-300 transition-colors">
            <h3 class="font-semibold text-sm text-gray-900 leading-6">{b.title}</h3>
          </a>
        ))}
      </div>
    </section>

    <nav class="mt-8 text-sm text-gray-500">
      <a href="/blog" class="text-brand-600 hover:underline">← همه مقالات</a> | <a href="/" class="text-brand-600 hover:underline">خانه</a> | <a href="/hotels" class="text-brand-600 hover:underline">هتل‌های ارومیه</a>
    </nav>
  </article>
</BaseLayout>
