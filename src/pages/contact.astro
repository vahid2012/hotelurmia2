---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../data/site';

const title = 'تماس با آکای تراول | رزرو هتل ارومیه';
const description = 'راه‌های ارتباطی آژانس گردشگری آکای تراول برای رزرو هتل و تور ارومیه.';

const agencySchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: BUSINESS.name,
  telephone: BUSINESS.phoneIntl,
  address: { '@type': 'PostalAddress', addressLocality: 'ارومیه', streetAddress: BUSINESS.address },
  url: 'https://hotelurmia.ir/contact',
  sameAs: [BUSINESS.instagramUrl],
};
---
<BaseLayout title={title} description={description} path="/contact" schema={agencySchema}>
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-brand-800 mb-4">تماس با آکای تراول</h1>
    <p class="text-gray-600 mb-8 max-w-2xl">برای رزرو هتل، تور و سرویس‌های گردشگری ارومیه از راه‌های زیر با ما در ارتباط باشید.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <div class="bg-white rounded-2xl p-6 border border-sand-200">
        <h2 class="font-bold text-brand-700 mb-3">اطلاعات تماس</h2>
        <ul class="space-y-3 text-sm text-gray-700">
          <li><span class="font-semibold">دفتر:</span> <a href={`tel:${BUSINESS.phoneIntl}`} class="text-brand-600 hover:underline" dir="ltr">{BUSINESS.phoneDisplay}</a></li>
          <li><span class="font-semibold">موبایل/واتساپ:</span> <a href={`tel:${BUSINESS.mobileIntl}`} class="text-brand-600 hover:underline" dir="ltr">{BUSINESS.mobileDisplay}</a></li>
          <li><span class="font-semibold">اینستاگرام:</span> <a href={BUSINESS.instagramUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">@{BUSINESS.instagram}</a></li>
          <li><span class="font-semibold">آدرس:</span> {BUSINESS.address}</li>
          <li><span class="font-semibold">مجوز:</span> {BUSINESS.license}</li>
        </ul>
      </div>
      <div class="bg-white rounded-2xl p-6 border border-sand-200">
        <h2 class="font-bold text-brand-700 mb-3">پیام‌رسان‌ها</h2>
        <ul class="space-y-3 text-sm text-gray-700">
          <li><a href={BUSINESS.telegramUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">تلگرام: @{BUSINESS.telegram}</a></li>
          <li><a href={BUSINESS.baleUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">بله: @{BUSINESS.bale}</a></li>
          <li><a href={BUSINESS.eitaaUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">ایتا: @{BUSINESS.eitaa}</a></li>
          <li><a href={BUSINESS.rubikaUrl} target="_blank" rel="noopener" class="text-brand-600 hover:underline">روبیکا: @{BUSINESS.rubika}</a></li>
          <li><a href={`https://wa.me/${BUSINESS.mobileIntl.replace('+','')}`} target="_blank" rel="noopener" class="text-green-600 hover:underline font-semibold">واتساپ</a></li>
        </ul>
      </div>
    </div>

    <div class="bg-sand-50 rounded-2xl p-6 text-sm text-gray-700 leading-8">
      <h2 class="font-bold text-brand-700 mb-2">چرا تماس مستقیم؟</h2>
      <p>برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید. رزرو مستقیم و بدون واسطه انجام می‌شود.</p>
    </div>

    <nav class="mt-8 text-sm text-gray-500">
      <a href="/" class="text-brand-600 hover:underline">خانه</a> | <a href="/hotels" class="text-brand-600 hover:underline">هتل‌های ارومیه</a> | <a href="/blog" class="text-brand-600 hover:underline">بلاگ</a>
    </nav>
  </section>
</BaseLayout>
