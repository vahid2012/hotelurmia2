---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReservationButtons from '../components/ReservationButtons.astro';
import { BUSINESS, HOTELS, BLOG_POSTS, SERVICES } from '../data/site';

const title = 'بهترین هتل ارومیه برای اقامت | آکای تراول';
const description = 'رزرو هتل‌های ارومیه، تورهای یک‌روزه و سرویس‌های گردشگری با آکای تراول؛ مجوز رسمی سازمان گردشگری آذربایجان غربی.';

const agencySchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: BUSINESS.name,
  telephone: BUSINESS.phoneIntl,
  address: { '@type': 'PostalAddress', addressLocality: 'ارومیه', streetAddress: BUSINESS.address },
  url: BUSINESS.siteUrl,
  sameAs: [BUSINESS.instagramUrl],
};
---
<BaseLayout title={title} description={description} path="/" schema={agencySchema}>
  <section class="relative bg-gradient-to-l from-brand-700 to-brand-500 text-white">
    <!-- TODO: real photo -->
    <img src="/images/hero-urmia.webp" alt="نمای شهر ارومیه و هتل‌های ارومیه" width="1200" height="630" class="absolute inset-0 w-full h-full object-cover opacity-30" fetchpriority="high" />
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-28">
      <h1 class="text-2xl md:text-4xl font-bold leading-snug mb-4">رزرو هتل‌های ارومیه و تورهای گردشگری</h1>
      <p class="text-base md:text-lg max-w-2xl mb-6 text-white/90">آژانس گردشگری آکای تراول با مجوز رسمی سازمان میراث فرهنگی، گردشگری و صنایع دستی آذربایجان غربی، رزرو هتل و تورهای ارومیه را بدون واسطه ارائه می‌دهد.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/hotels" class="bg-white text-brand-700 font-bold px-6 py-3 rounded-xl hover:bg-sand-50 transition-colors">مشاهده هتل‌ها</a>
        <a href="/tours/urmia-van-combined-tour" class="bg-brand-800 text-white font-bold px-6 py-3 rounded-xl hover:bg-brand-900 transition-colors">تور ارومیه به وان</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-xl md:text-2xl font-bold text-brand-800 mb-6">هتل‌های ارومیه</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {HOTELS.map((h) => (
        <a href={`/hotels/${h.slug}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-sand-200">
          <!-- TODO: real photo -->
          <img src={h.image} alt={h.nameFa} width="300" height="200" class="w-full h-40 object-cover" loading="lazy" />
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1">{h.nameFa}</h3>
            <p class="text-sm text-gray-600 line-clamp-2">{h.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-xl md:text-2xl font-bold text-brand-800 mb-6">چرا آکای تراول؟</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
      <div class="bg-white rounded-2xl p-5 border border-sand-200">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center mb-3">★</div>
        <h3 class="font-bold mb-1">مجوز رسمی</h3>
        <p class="text-sm text-gray-600">دارای مجوز سازمان گردشگری آذربایجان غربی.</p>
      </div>
      <div class="bg-white rounded-2xl p-5 border border-sand-200">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center mb-3">✕</div>
        <h3 class="font-bold mb-1">بدون واسطه</h3>
        <p class="text-sm text-gray-600">رزرو مستقیم و بدون کارمزار واسطه.</p>
      </div>
      <div class="bg-white rounded-2xl p-5 border border-sand-200">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center mb-3">○</div>
        <h3 class="font-bold mb-1">پشتیبانی</h3>
        <p class="text-sm text-gray-600">پشتیبانی از طریق تماس و پیام‌رسان‌ها.</p>
      </div>
      <div class="bg-white rounded-2xl p-5 border border-sand-200">
        <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center mb-3">△</div>
        <h3 class="font-bold mb-1">راهنمای محلی</h3>
        <p class="text-sm text-gray-600">آشنایی کامل با جاذبه‌های ارومیه و آذربایجان غربی.</p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-xl md:text-2xl font-bold text-brand-800 mb-6">سرویس‌های آکای تراول</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {SERVICES.map((s) => (
        <a href={`/${s.slug}`} class="bg-white rounded-2xl p-5 border border-sand-200 hover:border-brand-300 transition-colors">
          <h3 class="font-bold text-brand-700 mb-1">{s.title}</h3>
          <p class="text-sm text-gray-600">{s.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-xl md:text-2xl font-bold text-brand-800 mb-6">آخرین مقالات</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {BLOG_POSTS.slice(0, 4).map((b) => (
        <a href={`/blog/${b.slug}`} class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-sand-200">
          <!-- TODO: real photo -->
          <img src={b.image} alt={b.title} width="300" height="200" class="w-full h-40 object-cover" loading="lazy" />
          <div class="p-4">
            <h3 class="font-bold text-gray-900 mb-1 text-sm leading-6">{b.title}</h3>
            <p class="text-xs text-gray-500">{b.category}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl p-6 border border-sand-200">
      <h2 class="text-xl font-bold text-brand-800 mb-2">درخواست رزرو</h2>
      <p class="text-sm text-gray-600 mb-4">برای اطلاع از جزئیات و قیمت دقیق، با دفتر آکای تراول تماس بگیرید.</p>
      <ReservationButtons pageName="صفحه اصلی" />
    </div>
  </section>
</BaseLayout>
