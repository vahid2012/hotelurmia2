---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReservationButtons from '../../components/ReservationButtons.astro';
import { BUSINESS } from '../../data/site';

const title = 'بهترین رستوران‌های ارومیه | راهنمای غذا و اقامت';
const description = 'راهنمای رستوران‌های ارومیه برای مسافران؛ از غذاهای محلی مانند کباب بناب و دلمه تا رستوران‌های مدرن.';

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'رستوران‌های غذای محلی ارومیه' },
    { '@type': 'ListItem', position: 2, name: 'رستوران‌های مدرن ارومیه' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'بهترین غذاهای محلی ارومیه چیست؟', acceptedAnswer: { '@type': 'Answer', text: 'غذاهای محلی ارومیه شامل آش‌های متنوع، کباب بناب، دلمه و قره‌قروت هستند.' } },
    { '@type': 'Question', name: 'کجا می‌توانم غذاهای محلی ارومیه پیدا کنم؟', acceptedAnswer: { '@type': 'Answer', text: 'با راهنمایی آکای تراول می‌توانید رستوران‌های ارائه‌دهنده غذاهای محلی را در ارومیه پیدا کنید.' } },
    { '@type': 'Question', name: 'آیا رستوران‌های ارومیه برای خانواده‌ها مناسب است؟', acceptedAnswer: { '@type': 'Answer', text: 'بله، رستوران‌های ارومیه با تنوع غذا و فضای خانوادگی، برای مسافران خانوادگی مناسب هستند.' } },
    { '@type': 'Question', name: 'هزینه غذا در رستوران‌های ارومیه چقدر است؟', acceptedAnswer: { '@type': 'Answer', text: 'برای اطلاع از جزئیات دقیق قیمت، با دفتر آکای تراول تماس بگیرید.' } },
  ],
};
---
<BaseLayout title={title} description={description} path="/restaurants/best-urmia-restaurants" schema={[restaurantSchema, faqSchema]}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <!-- TODO: replace with real photo -->
    <img src="/images/urmia-restaurants.webp" alt="بهترین رستوران‌های ارومیه با غذاهای محلی" width="1200" height="630" class="w-full h-64 md:h-80 object-cover rounded-2xl mb-6" fetchpriority="high" />
    <h1 class="text-2xl md:text-3xl font-bold text-brand-800 mb-4">بهترین رستوران‌های ارومیه</h1>
    <p class="text-gray-700 leading-8 mb-6">ارومیه با تنوع غذاهای محلی و رستوران‌های مدرن، گزینه‌های متعددی برای مسافران ارائه می‌دهد. از غذاهای اصیل آذربایجانی مانند آش، کباب بناب، دلمه و قره‌قروت تا رستوران‌های مدرن با تنوع غذایی، این شهر فرصتی برای تجربه غذایی غنی فراهم می‌کند. در این راهنما به معرفی غذاهای محلی، رستوران‌های ارومیه و نکته‌هایی برای تجربه غذایی در سفر می‌پردازیم. آکای تراول به‌عنوان آژانس دارای مجوز از سازمان میراث فرهنگی، گردشگری و صنایع دستی آذربایجان غربی، در زمینه راهنمایی مسافران به رستوران‌های معتبر کمک می‌کند.</p>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-3">غذاهای محلی آذربایجان غربی</h2>
      <p class="text-gray-700 leading-8 mb-4">غذاهای محلی آذربایجان غربی با ریشه‌ای عمیق در فرهنگ منطقه، طعم‌هایی اصیل و متفاوت ارائه می‌دهند. این غذاها با ترکیب مواد اولیه محلی و روش‌های پخت سنتی، هویت غذایی ویژه‌ای دارند که بازدید از ارومیه را کامل می‌کنند.</p>
      <!-- TODO: replace with real photo -->
      <img src="/images/urmia-local-food.webp" alt="غذاهای محلی ارومیه شامل کباب بناب و دلمه" width="800" height="500" class="w-full h-56 object-cover rounded-xl my-4" loading="lazy" />
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-3">فهرست غذاهای شناخته‌شده ارومیه</h2>
      <div class="bg-white rounded-xl border border-sand-200 overflow-hidden">
        <table class="w-full text-sm text-gray-700">
          <thead class="bg-sand-100">
            <tr><th class="text-right p-3 font-bold">نام غذا</th><th class="text-right p-3 font-bold">ویژگی</th></tr>
          </thead>
          <tbody>
            <tr class="border-t border-sand-200"><td class="p-3 font-semibold">آش‌های محلی</td><td class="p-3">ترکیب حبوبات و سبزیجات، غذایی مقوی و سنتی</td></tr>
            <tr class="border-t border-sand-200"><td class="p-3 font-semibold">کباب بناب</td><td class="p-3">روش پخت ویژه از شهر بناب</td></tr>
            <tr class="border-t border-sand-200"><td class="p-3 font-semibold">دلمه</td><td class="p-3">با برگ مو یا کلم، غذای محافل خانوادگی</td></tr>
            <tr class="border-t border-sand-200"><td class="p-3 font-semibold">قره‌قروت</td><td class="p-3">غذای سنتی با پایه لبنیات</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-3">رستوران‌های مدرن ارومیه</h2>
      <p class="text-gray-700 leading-8 mb-4">علاوه بر غذاهای محلی، رستوران‌های مدرن ارومیه با تنوع غذایی، گزینه‌هایی برای مسافرانی ارائه می‌دهند که به دنبال تنوع در سفر خود هستند. این رستوران‌ها با فضایی مدرن و منوی متنوع، تجربه غذایی متفاوتی فراهم می‌کنند. با راهنمایی آکای تراول می‌توانید رستوران‌های مناسب را پیدا کنید. برای اطلاع از جزئیات دقیق، با دفتر آکای تراول تماس بگیرید.</p>
      <!-- TODO: replace with real photo -->
      <img src="/images/urmia-modern-restaurant.webp" alt="رستوران مدرن در ارومیه" width="800" height="500" class="w-full h-56 object-cover rounded-xl my-4" loading="lazy" />
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-3">تجربه غذایی در کنار اقامت</h2>
      <p class="text-gray-700 leading-8 mb-4">مسافرانی که در <a href="/hotels" class="text-brand-600">هتل‌های ارومیه</a> اقامت دارند، می‌توانند با راهنمایی آکای تراول، رستوران‌های ارائه‌دهنده غذاهای محلی را در نزدیکی هتل پیدا کنند. برای اقامت در ارومیه، <a href="/hotels/jahangardi-urmia" class="text-brand-600">هتل جهانگردی ارومیه</a> و <a href="/hotels/ana-urmia" class="text-brand-600">هتل آنا ارومیه</a> گزینه‌هایی با سطوح مختلف هستند. ترکیب اقامت راحت و تجربه غذایی اصیل، سفر به ارومیه را کامل می‌کند.</p>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold text-brand-700 mb-4">رزرو و راهنمایی</h2>
      <ReservationButtons pageName="بهترین رستوران‌های ارومیه" />
    </section>

    <section class="bg-sand-50 rounded-xl p-5 mb-8">
      <h2 class="text-lg font-bold text-brand-700 mb-3">سؤالات متداول</h2>
      <div class="space-y-4">
        <div><h3 class="font-semibold text-gray-900 mb-1">بهترین غذاهای محلی ارومیه چیست؟</h3><p class="text-sm text-gray-600 leading-7">غذاهای محلی ارومیه شامل آش‌های متنوع، کباب بناب، دلمه و قره‌قروت هستند.</p></div>
        <div><h3 class="font-semibold text-gray-900 mb-1">کجا می‌توانم غذاهای محلی ارومیه پیدا کنم؟</h3><p class="text-sm text-gray-600 leading-7">با راهنمایی آکای تراول می‌توانید رستوران‌های ارائه‌دهنده غذاهای محلی را در ارومیه پیدا کنید.</p></div>
        <div><h3 class="font-semibold text-gray-900 mb-1">آیا رستوران‌های ارومیه برای خانواده‌ها مناسب است؟</h3><p class="text-sm text-gray-600 leading-7">بله، رستوران‌های ارومیه با تنوع غذا و فضای خانوادگی، برای مسافران خانوادگی مناسب هستند.</p></div>
        <div><h3 class="font-semibold text-gray-900 mb-1">هزینه غذا در رستوران‌های ارومیه چقدر است؟</h3><p class="text-sm text-gray-600 leading-7">برای اطلاع از جزئیات دقیق قیمت، با دفتر آکای تراول تماس بگیرید.</p></div>
      </div>
    </section>

    <nav class="text-sm text-gray-500">
      <a href="/" class="text-brand-600 hover:underline">خانه</a> | <a href="/hotels" class="text-brand-600 hover:underline">هتل‌ها</a> | <a href="/tours/urmia-van-combined-tour" class="text-brand-600 hover:underline">تورها</a> | <a href="/blog/azarbaijan-gharbi-turkic-culture" class="text-brand-600 hover:underline">فرهنگ آذربایجان</a>
    </nav>
  </article>
</BaseLayout>
