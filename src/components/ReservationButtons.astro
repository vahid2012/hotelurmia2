---
import { BUSINESS, SUPPLEMENT_SERVICES } from '../data/site';

export interface Props {
  pageName: string;
  showSupplements?: boolean;
}

const { pageName, showSupplements = true } = Astro.props;
const waBase = `https://wa.me/${BUSINESS.mobileIntl.replace('+','')}`;
---
<div class="reservation-block">
  {showSupplements && (
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-4 text-sm">
      {SUPPLEMENT_SERVICES.map((s) => (
        <label class="flex items-center gap-2 bg-sand-50 border border-sand-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-sand-100 transition-colors">
          <input type="checkbox" class="svc-checkbox accent-brand-600" data-text={s.text} />
          <span>{s.label}</span>
        </label>
      ))}
    </div>
  )}

  <div class="flex flex-wrap gap-2">
    <button id="wa-btn" class="rb-btn bg-green-500 hover:bg-green-600 text-white" data-wa={waBase} data-page={pageName}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.042zm5.323-10.541c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      رزرو با واتساپ
    </button>
    <a href={BUSINESS.baleUrl} target="_blank" rel="noopener" class="rb-btn bg-emerald-600 hover:bg-emerald-700 text-white">بله</a>
    <a href={BUSINESS.eitaaUrl} target="_blank" rel="noopener" class="rb-btn bg-rose-600 hover:bg-rose-700 text-white">ایتا</a>
    <a href={BUSINESS.rubikaUrl} target="_blank" rel="noopener" class="rb-btn bg-orange-500 hover:bg-orange-600 text-white">روبیکا</a>
    <button id="copy-btn" class="rb-btn bg-sand-600 hover:bg-sand-700 text-white">کپی متن</button>
    <a href={`tel:${BUSINESS.mobileIntl}`} class="rb-btn bg-brand-600 hover:bg-brand-700 text-white">تماس: {BUSINESS.mobileDisplay}</a>
  </div>
</div>

<style>
  .rb-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 0.15s ease, transform 0.1s ease;
    cursor: pointer;
  }
  .rb-btn:active { transform: scale(0.97); }
</style>

<script is:inline define:vars={{ pageName }}>
  function buildMessage() {
    const checked = Array.from(document.querySelectorAll('.svc-checkbox:checked')).map((c) => c.getAttribute('data-text'));
    let msg = `سلام، از سایت hotelurmia.ir درخواست «${pageName}» دارم.\n`;
    if (checked.length) {
      msg += `سرویس‌های تکمیلی درخواستی:\n` + checked.map((t) => `- ${t}`).join('\n') + `\n`;
    }
    msg += `لطفاً قیمت و شرایط را ارسال کنید.`;
    return msg;
  }
  const waBtn = document.getElementById('wa-btn');
  if (waBtn) {
    waBtn.addEventListener('click', () => {
      const base = waBtn.getAttribute('data-wa');
      const msg = encodeURIComponent(buildMessage());
      window.open(`${base}?text=${msg}`, '_blank', 'noopener');
    });
  }
  const copyBtn = document.getElementById('copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(buildMessage());
        copyBtn.textContent = 'کپی شد ✓';
        setTimeout(() => (copyBtn.textContent = 'کپی متن'), 2000);
      } catch (e) {
        copyBtn.textContent = 'خطا در کپی';
        setTimeout(() => (copyBtn.textContent = 'کپی متن'), 2000);
      }
    });
  }
</script>
